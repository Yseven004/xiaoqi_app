[Unit]
Description=Xiaoqi single-server API and DSH task worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xiaoqi
Group=xiaoqi
WorkingDirectory=/opt/xiaoqi/xiaoqi_harness
EnvironmentFile=/etc/xiaoqi/single-server.env
Environment=XIAOQI_SINGLE_SERVER=1
Environment=XIAOQI_DATA_DIR=/var/lib/xiaoqi
Environment=HOME=/run/xiaoqi
Environment=TMPDIR=/run/xiaoqi
StateDirectory=xiaoqi
StateDirectoryMode=0700
RuntimeDirectory=xiaoqi
RuntimeDirectoryMode=0700
ExecStart=/opt/xiaoqi/venv/bin/gunicorn --workers 1 --worker-class gthread --threads 8 --timeout 180 --graceful-timeout 30 --bind 127.0.0.1:8080 single_server:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/xiaoqi /run/xiaoqi

[Install]
WantedBy=multi-user.target
