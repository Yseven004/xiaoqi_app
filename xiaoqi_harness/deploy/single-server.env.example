# Copy to deploy/single-server.env on the server. Keep real credentials there only.
XIAOQI_PUBLIC_HOST=47-76-60-77.sslip.io

# Single-owner email sign-in
CAPABILITY_OWNER_EMAIL=
CAPABILITY_SMTP_HOST=smtp.qq.com
CAPABILITY_SMTP_PORT=465
CAPABILITY_SMTP_USERNAME=
CAPABILITY_SMTP_PASSWORD=
CAPABILITY_AUTH_CODE_PEPPER=
CAPABILITY_HARNESS_TENANTS=personal

# Text model providers
XIAOQI_DEFAULT_TEXT_MODEL=mimo-v2.5
XIAOQI_TEXT_TEMPERATURE=0.4
DEEPSEEK_API_KEY=
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Volcengine Ark Seedream image generation
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
ARK_IMAGE_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations

# Local Docker sandbox executor. Generate on the server with: openssl rand -hex 32
SANDBOX_RUNNER_TOKEN=
